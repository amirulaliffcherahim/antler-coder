{
  "$schema": "../node_modules/@tauri-apps/cli/schema/capability-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-create",
    "fs:allow-exists",
    "os:default",
    "process:default",
    "shell:default",
    "store:default",
    "updater:default"
  ]
}
